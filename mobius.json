{
  "id": "editor",
  "name": "Files",
  "version": "0.7.0",
  "description": "Browse and preview files on this Möbius.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-editor",
  "entry": "index.jsx",
  "source_files": [
    "constants.js",
    "domain.js",
    "storage.js",
    "theme.js"
  ],
  "icon": "icon.png",
  "offline_capable": false,
  "offline": {
    "reads": false,
    "writes": "none",
    "execution": "none"
  },
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none",
    "filesystem_access": true
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "@openai/apps-sdk-ui/components/Icon"
    ],
    "esm_deps": []
  }
}
